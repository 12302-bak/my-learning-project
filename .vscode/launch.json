{
    "configurations": [
        {
            "name": "learning Launch",
            "type": "cppdbg",
            "request": "launch",
            // ${workspaceFolder} : https://code.visualstudio.com/docs/reference/variables-reference
            "program": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-q -ex quit; wait() { fg >/dev/null; }; /bin/gdb -q --interpreter=mi",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                // https://github.com/microsoft/vscode-cpptools/issues/1210
                {
                    "description": "Set command line arguments",
                    "text": "-gdb-set args ${input:fileContentKey}",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "sourceFileMap": {
                "./csu": "/usr/src/glibc/glibc-2.39/csu",
                "../sysdeps": "/usr/src/glibc/glibc-2.39/sysdeps",
                "./sysdeps": "/usr/src/glibc/glibc-2.39/sysdeps",
                "./nptl": "/usr/src/glibc/glibc-2.39/nptl"
            },
            "preLaunchTask": "cmake: build"
        },
    ],
    "inputs": [
        {
            "id": "fileContentKey",
            "type": "command",
            "command": "extension.commandvariable.file.content",
            "args": {
                "fileName": "${file}",
                "key": "* @args",
                "debug": false,
                "default": "--help"
            }
        }
    ],
    "version": "2.0.0"
}